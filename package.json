{
  "name": "gamma-slides",
  "version": "2.0.2",
  "packageManager": "bun@1.3.11",
  "description": "Professional presentation & video generator — declarative YAML/JSON decks, narrated videos, LLM-pilotable via MCP",
  "type": "module",
  "main": "src/desktop/main.js",
  "bin": {
    "gamma-slides": "./bin/gamma-slides.js"
  },
  "files": [
    "bin/",
    "src/",
    "assets/",
    "build/icon.svg",
    "setup.sh",
    "docker-entrypoint.sh",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    ".agents/skills/repo-presentation/",
    "docs/repository-presentations.md",
    "docs/gamma-presenter-macos.md",
    "docs/images/",
    "docs/presenter-studio.md",
    "docs/youtube-production.md"
  ],
  "scripts": {
    "start": "bun bin/gamma-slides.js",
    "desktop": "electron .",
    "desktop:package": "electron-builder --mac",
    "desktop:smoke": "bun scripts/agent/smoke-desktop.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "bunx playwright test",
    "mcp": "bun src/mcp/server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hbfs-cloud/gamma-slides.git"
  },
  "homepage": "https://github.com/hbfs-cloud/gamma-slides",
  "keywords": [
    "slides",
    "presentation",
    "video",
    "tts",
    "mcp",
    "llm",
    "charts",
    "echarts",
    "reveal.js",
    "youtube",
    "narration",
    "deck",
    "generator",
    "claude",
    "ai"
  ],
  "author": "hbfs-cloud",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/azeret-mono": "^5.2.8",
    "@fontsource-variable/instrument-sans": "5.2.8",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "chart.js": "4.4.0",
    "commander": "^14.0.3",
    "d3": "^7.9.0",
    "echarts": "6.1.0",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "js-yaml": "^4.3.2",
    "node-pty": "^1.1.0",
    "open": "^11.0.0",
    "ora": "^9.3.0",
    "pixi.js": "^8.14.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^24.40.0",
    "reveal.js": "5.1.0",
    "three": "^0.185.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "trustedDependencies": [
    "node-pty"
  ],
  "build": {
    "appId": "com.gamma-slides.presenter",
    "productName": "Gamma Presenter",
    "icon": "build/icon.svg.png",
    "files": [
      "src/desktop/**",
      "src/engine/**",
      "src/themes/**",
      "src/loader/**",
      "src/schema/**",
      "src/vendor/**",
      "build/icon.svg",
      "build/icon.svg.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    }
  }
}
